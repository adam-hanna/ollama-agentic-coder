# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=4096
OLLAMA_TIMEOUT=300

# Agent Configuration  
AGENT_MAX_ITERATIONS=10
AGENT_ENABLE_MEMORY=true
AGENT_MEMORY_WINDOW=20

# Search Configuration
SEARCH_ENGINE=duckduckgo
SEARCH_MAX_RESULTS=5

# Code Analyzer Configuration
CODE_ANALYZER_MAX_FILE_SIZE=1048576
CODE_ANALYZER_ENABLE_AST=true
CODE_ANALYZER_AUTO_BACKGROUND_INDEXING=true
CODE_ANALYZER_WATCH_FILE_CHANGES=true

# Command Line Safety Configuration
COMMAND_SAFETY_MODE=safe
COMMAND_MAX_OUTPUT_LENGTH=10000
COMMAND_TIMEOUT_SECONDS=30

# Context Manager Configuration  
CONTEXT_AUTO_SUMMARIZE=true
CONTEXT_MAX_AGE_HOURS=168
CONTEXT_STORE_MAX_SIZE=1000
CONTEXT_AUTO_THRESHOLD=15
CONTEXT_ENABLE_SEMANTIC_SEARCH=false
CONTEXT_RELEVANCE_THRESHOLD=1.0